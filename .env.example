# Public Business Website Environment Variables

# The base URL of the 3D Printing Business Dashboard API (hosted on Vercel)
# Local development default: http://localhost:3000 (when dashboard is running locally)
# Production example: https://app.printstudio.ae or your Vercel deployment URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# WhatsApp business contact number (international format without '+' or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567

# Instagram handle
NEXT_PUBLIC_INSTAGRAM_HANDLE=printstudio.ae

# Studio business location & contact email
NEXT_PUBLIC_STUDIO_LOCATION=Dubai Industrial City, Dubai, United Arab Emirates
NEXT_PUBLIC_STUDIO_EMAIL=hello@printstudio.ae
NEXT_PUBLIC_STUDIO_PHONE=+971 4 123 4567
